#!/bin/sh
# phi: pi, pointed at phi's own configuration.
#
# pi keeps everything about an install under one agent directory: settings,
# installed packages, sessions. PI_CODING_AGENT_DIR chooses which, so running
# pi against a different one gives a completely separate install sharing a
# single binary.
#
# That is the whole trick. `phi` gets the extensions, the purple theme, the
# fullscreen TUI and the local model roster; `pi` gets none of it and behaves
# exactly as it does everywhere else. Neither can disturb the other, because
# they do not share a settings file, and sessions started in one do not appear
# in the other.
#
# Override the location with PHI_HOME if ~/.phi is not where you want it.
set -e

if ! command -v pi >/dev/null 2>&1; then
  echo "phi: pi is not installed. npm i -g @earendil-works/pi-coding-agent" >&2
  exit 127
fi

PHI_HOME="${PHI_HOME:-$HOME/.phi}"
export PI_CODING_AGENT_DIR="$PHI_HOME"

# phi reports pi and phi updates itself, in the boot box, with a prompt that
# installs them. pi's own startup checks would report the same two things again
# a second later, in a different place, telling you to run a command by hand.
# PI_OFFLINE turns off pi's startup network calls (its version banner, its
# package-update banner, the remote model catalog refresh). Nothing here needs
# that catalog: the models are local. The update commands drop the flag again,
# see online() in extensions/boot-screen.ts.
export PI_OFFLINE="${PI_OFFLINE:-1}"

if [ ! -f "$PHI_HOME/settings.json" ]; then
  echo "phi: no configuration at $PHI_HOME. Re-run get-phi.sh." >&2
  exit 1
fi

# `pi -v` prints pi's version, which under this name is the wrong answer: the
# thing you typed is phi, and its version is what decides whether you have a
# given fix. pi's is still worth printing, since almost everything phi does is
# constrained by it, so both are shown and labelled.
#
# Handled here rather than in an extension because --version never starts a
# session: pi prints and exits before any extension loads.
case "$1" in
  -v|--version)
    ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
    PHI_VERSION="$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$ROOT/package.json" 2>/dev/null | head -1)"
    echo "phi ${PHI_VERSION:-unknown}"
    echo "pi  $(pi --version 2>/dev/null || echo unknown)"
    exit 0
    ;;
esac

exec pi "$@"
