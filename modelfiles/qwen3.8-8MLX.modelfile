# 8-bit mxfp8 weights (31GB) — best quality, needs the machine to itself.
# Starts at high thinking; Shift+Tab lowers it.
# 50K context: weights + a full 50K q8_0 cache is ~37.5GB against a 40GB wired
# limit. Tight. Measured KV cost is ~130KB/token.
FROM qwen3.8:27b-mxfp8
PARAMETER num_ctx 51200
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 20
